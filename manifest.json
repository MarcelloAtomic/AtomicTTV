{
  "manifest_version": 3,
  "name": "AtomicTTV",
  "version": "1.0.0",
  "description": "Experimental Twitch ad-filtering and playback-recovery extension.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "js": [
        "atomicttv/atomicttv.user.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
